# Public API origin only. Never put an OpenRouter key in a VITE_* variable.
# Local development uses the Mac mini API at http://localhost:8000.
# GitHub Pages receives the production value from the VITE_API_BASE_URL
# repository variable during the deploy workflow.
VITE_API_BASE_URL=http://localhost:8000
# Kept as a compatibility alias for older local prototypes.
VITE_AI_ENDPOINT=
